(+ 2 3)                                         ; devrait retourner 5
(let x 5 (+ x 3))                               ; devrait retourner 8
(if true 42 0)                                  ; devrait retourner 42
((fob (x) (+ x 1)) 4)                           ; devrait retourner 5
(fix (((even x) (if (= x 0) true (odd (- x 1))))
      ((odd x) (if (= x 0) false (even (- x 1)))))
 (even 4))                                      ; devrait retourner true
